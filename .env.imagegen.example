# Copy to .env.imagegen.local and fill in the key locally.
# These settings are loaded by Tools/Kairos.Art/imagegen.py, not by Unity.
OPENAI_BASE_URL=https://tc-paperhub.diezhi.net/v1
OPENAI_API_KEY=
# Available: gpt-image-2, gpt-image-2.5-flare, gpt-image-2.5-sunburst
OPENAI_IMAGE_MODEL=gpt-image-2
